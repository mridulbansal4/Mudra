{
  "name": "samadhan-os",
  "private": true,
  "version": "0.1.0",
  "description": "SAMADHAN-OS (SamvadDeal) — multilingual escrow, live video assay and freeze arbitration on Nexconn",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @samadhan/web dev",
    "dev:bridge": "pnpm --filter @samadhan/nexconn-bridge-node dev",
    "dev:go": "cd services/deal-engine-go && go run ./cmd/server",
    "build": "pnpm -r --filter ./packages/** --filter ./services/** --filter ./apps/** run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:go": "cd services/deal-engine-go && go test ./...",
    "smoke": "node scripts/smoke.mjs"
  }
}
