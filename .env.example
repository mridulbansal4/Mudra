# =============================================================================
# MUDRA-OS (SamvadDeal) - Root Environment Configuration (.env.example)
# Copy to `.env` (`cp .env.example .env`) before running `pnpm dev`.
# NEVER commit real API keys or secrets to git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. NEXCONN UNIFIED COMMUNICATIONS PLATFORM (https://console.nexconn.ai)
# Required by `services/nexconn-bridge-node` (:4001) & `apps/web` (:5173)
# See `docs/03-engineering/NEXCONN_SDK_MANUAL.md` for step-by-step console setup.
# -----------------------------------------------------------------------------
# Public App Key (safe for browser/mobile NCEngine.initialize({ appKey }))
NEXCONN_APP_KEY="nc_app_replace_with_console_nexconn_ai_app_key"
VITE_NEXCONN_APP_KEY="nc_app_replace_with_console_nexconn_ai_app_key"
EXPO_PUBLIC_NEXCONN_APP_KEY="nc_app_replace_with_console_nexconn_ai_app_key"

# Server-Only Secret Key (NEVER expose in VITE_* or EXPO_PUBLIC_* variables!)
NEXCONN_SECRET_KEY="nc_sec_replace_with_console_nexconn_ai_secret_key"

# Nexconn REST API v4 & WebSocket Endpoints
# Singapore Server API hosts (docs.nexconn.ai → Platform Chat API → Base URL); primary + backup for failover
NEXCONN_PRIMARY_API_DOMAIN="https://api.sg-light-api.com"
NEXCONN_SECONDARY_API_DOMAIN="https://api-b.sg-light-api.com"
VITE_NEXCONN_WS_URL="wss://ws.nexconn.ai"

# System Bot User IDs provisioned in Nexconn Console for Stream & System cards
NEXCONN_ARBITRATOR_BOT_ID="usr_mudra_arbitrator_bot"
NEXCONN_SHOPKEEPER_BOT_ID="usr_chanakya_shopkeeper_bot"
NEXCONN_SYSTEM_VOUCHER_BOT_ID="usr_mudra_system_voucher"

# -----------------------------------------------------------------------------
# 2. SERVICE PORTS & INTERNAL SERVICE-TO-SERVICE AUTHENTICATION
# -----------------------------------------------------------------------------
NODE_ENV="development"

# Service 1: Node.js 22 Fastify Nexconn Bridge (:4001, internal @nexconn/server-sdk@0.1.2 host)
BRIDGE_PORT=4001
NEXCONN_BRIDGE_URL="http://127.0.0.1:4001"

# Service 2: Go 1.24 Public API Gateway (`/api/v1/*`), Deterministic Escrow FSM & Telemetry (:4002)
GO_DEAL_ENGINE_PORT=4002
GO_DEAL_ENGINE_URL="http://127.0.0.1:4002"
VITE_API_GATEWAY_URL="http://127.0.0.1:4002"
EXPO_PUBLIC_API_GATEWAY_URL="http://127.0.0.1:4002"

# Service 3: Rust 1.85 Video pHash / Audio FFT / DPDP PII Verifier (:4003)
RUST_ASSAY_VERIFIER_PORT=4003
RUST_ASSAY_VERIFIER_URL="http://127.0.0.1:4003"
RUST_LOG="assay_verifier_rs=info,tower_http=info"

# Shared HMAC-SHA256 secret between Node Bridge (:4001), Go FSM (:4002), and Rust (:4003)
INTERNAL_SERVICE_HMAC_SECRET="dev_internal_hmac_secret_change_in_prod_32b"

# -----------------------------------------------------------------------------
# 3. DATA LAYER (PostgreSQL 17 + DragonflyDB / Redis 7.4)
# Started via `docker compose -f infra/docker/docker-compose.yml up -d`
# -----------------------------------------------------------------------------
DATABASE_URL="postgres://mudra:mudra_dev_pass@localhost:5432/mudra_os?sslmode=disable"
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

REDIS_URL="redis://localhost:6379/0"
REDIS_IDEMPOTENCY_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC VOUCHER SIGNING & WEBHOOK SECURITY
# Used by `services/assay-verifier-rs` (Ed25519) & `services/deal-engine-go` (HMAC)
# -----------------------------------------------------------------------------
# 64-hex-char (32-byte) Ed25519 seed for signing `System` channel escrow vouchers (E-08)
ASSAY_ED25519_PRIVATE_KEY_HEX="0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20"
ASSAY_ED25519_PUBLIC_KEY_HEX="d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"

# Secret used by `services/deal-engine-go` to verify `X-Mudra-Signature` on UPI/ONDC webhooks
UPI_WEBHOOK_HMAC_SECRET="whsec_dev_upi_setu_razorpayx_hmac_secret_32b"

# -----------------------------------------------------------------------------
# 5. AI MODELS & MULTILINGUAL ASR (M-01..M-05)
# All outbound text is scrubbed by Rust `POST /internal/scrub-pii` (<300us) first.
# -----------------------------------------------------------------------------
# Google Gemini API (M-01 Flash Bilingual Translator, M-03 Flash Vision, M-04 Pro Tribunal, M-05 Chanakya Shopkeeper)
GEMINI_API_KEY="AIzaSy_replace_with_your_gemini_api_key"
GEMINI_FLASH_MODEL="gemini-2.5-flash"
GEMINI_PRO_MODEL="gemini-2.5-pro"

# Bhashini ULCA / MeitY ASR (M-02 Conformer ASR for hi-IN, mr-IN, ta-IN, en-IN)
BHASHINI_USER_ID="replace_with_bhashini_ulca_user_id"
BHASHINI_ULCA_API_KEY="replace_with_bhashini_ulca_api_key"
BHASHINI_PIPELINE_ID="64392f96daac500b55c543cd"

# Together AI (Fallback Llama-3.3-70B-Instruct if Gemini rate-limits)
TOGETHER_API_KEY="tgp_v1_replace_with_optional_together_fallback_key"

# -----------------------------------------------------------------------------
# 6. CANONICAL FEATURE FLAGS (`FF_*` - Defined in `docs/01-product/FEATURES.md` §2)
# -----------------------------------------------------------------------------
# Enables pre-recorded 1080p60 inspection stream + real audio motor waveform when no webcam is attached
FF_SIMULATED_HD_CAMERA="true"

# Enforces mandatory Rust <300us Aho-Corasick DPDP PII scrubbing on every outbound prompt
FF_RUST_PII_SCRUBBER_STRICT="true"

# Enables automated multilingual counterparty replies in `/sandbox` and `/arena`
FF_AI_COUNTERPARTY_AUTOREPLY="true"

# Enables Bhashini ASR primary pipeline with automatic Gemini 2.5 Flash audio fallback on timeout
FF_BHASHINI_FALLBACK_ENABLED="true"

# Enables 3-keyframe Burst Assay Mode fallback if WebRTC UDP is blocked (`R-04`)
FF_WEBRTC_KEYFRAME_FALLBACK="true"

# Enables contextual beginner story coachmarks and the 4-Stage Deal Story Bar (`F-01`, `F-02`)
FF_STORY_COACHMARKS_ACTIVE="true"

# Experimental ONDC 1.2.0 Beckn adapter mapping (default off for hackathon core flow)
FF_ONDC_ADAPTER="false"
